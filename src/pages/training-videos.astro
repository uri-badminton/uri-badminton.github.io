---
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { youtubeVideos } from "../data/youtube";
---

<BaseLayout title="Training Videos" description="The latest videos from the URI Badminton Club YouTube channel.">
  <section class="page-hero training-hero">
    <div class="container narrow">
      <p class="eyebrow">Learn between practices</p>
      <h1>Training Videos</h1>
      <p>The latest uploads from the URI Badminton Club YouTube channel, updated automatically.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {youtubeVideos.length > 0 ? (
        <div class="video-grid">
          {youtubeVideos.map((video) => (
            <VideoCard
              title={video.title}
              date={video.published}
              youtubeId={video.youtubeId}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state large-empty">
          <span class="empty-icon" aria-hidden="true">▶</span>
          <h2>Our new channel is live</h2>
          <p>There are no public uploads yet. New videos will appear here automatically after they are published.</p>
          <a class="button button-primary" href={site.contact.youtubeChannelUrl} target="_blank" rel="noopener">
            Visit our YouTube channel
          </a>
        </div>
      )}
      {youtubeVideos.length > 0 && (
        <div class="channel-action">
          <p>YouTube keeps the complete video archive.</p>
          <a class="button button-outline" href={site.contact.youtubeChannelUrl} target="_blank" rel="noopener">
            View the full channel
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
