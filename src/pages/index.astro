---
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import { youtubeVideos } from "../data/youtube";

const recentVideos = youtubeVideos.slice(0, 3);
const nextPractice = site.practiceSchedule[0];
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Student-run badminton community</p>
        <h1>{site.hero.heading}</h1>
        <p class="hero-description">{site.hero.description}</p>
        <div class="button-group">
          <a class="button button-primary" href="/join/">Join a Practice</a>
          <a class="button button-secondary" href="/training-videos/">Watch Training Videos</a>
        </div>
      </div>
      <div class="hero-brand-panel">
        {site.hero.imagePath ? (
          <img class="hero-image" src={site.hero.imagePath} alt={site.hero.imageAlt ?? ""} width="1200" height="630" />
        ) : (
          <>
            <img src="/uri-badminton-logo.png" alt="" width="300" height="300" />
            <p>
              <strong>All skill levels welcome.</strong>
              Come as you are. Play at your pace.
            </p>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="section home-practice" aria-labelledby="next-practice-heading">
    <div class="container split-section">
      <div class="section-heading">
        <p class="eyebrow">Get on court</p>
        <h2 id="next-practice-heading">Practice with us</h2>
        <p>Confirmed weekly practice details will appear here as soon as they are available.</p>
        <a class="text-link" href="/schedule/">View schedule <span aria-hidden="true">→</span></a>
      </div>
      <article class="practice-card">
        <p class="practice-label">{nextPractice.label}</p>
        <dl>
          <div><dt>Day</dt><dd>{nextPractice.day}</dd></div>
          <div><dt>Time</dt><dd>{nextPractice.time}</dd></div>
          <div><dt>Location</dt><dd>{nextPractice.location}</dd></div>
        </dl>
        <p class="practice-note">{nextPractice.note}</p>
      </article>
    </div>
  </section>

  <section class="section section-tint home-videos" aria-labelledby="videos-heading">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">From our channel</p>
          <h2 id="videos-heading">Latest videos</h2>
        </div>
        <a class="text-link desktop-only-link" href="/training-videos/">Browse videos <span aria-hidden="true">→</span></a>
      </div>
      {recentVideos.length > 0 ? (
        <div class="video-grid">
          {recentVideos.map((video) => (
            <VideoCard
              title={video.title}
              date={video.published}
              youtubeId={video.youtubeId}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-icon" aria-hidden="true">▶</span>
          <h3>The channel is ready</h3>
          <p>New uploads from URI Badminton will appear here automatically.</p>
          <a class="button button-primary" href={site.contact.youtubeChannelUrl} target="_blank" rel="noopener">
            Visit our YouTube channel
          </a>
        </div>
      )}
      <a class="text-link mobile-only-link" href="/training-videos/">Browse videos <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="join-band home-join-band">
    <div class="container join-band-inner">
      <div>
        <p class="eyebrow">Your next rally starts here</p>
        <h2>There’s a place for you on court.</h2>
        <p>Come meet the community, try a practice, and play at your pace.</p>
      </div>
      <a class="button button-gold" href="/join/">How to join</a>
    </div>
  </section>
</BaseLayout>
