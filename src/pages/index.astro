---
import { getCollection } from "astro:content";
import AnnouncementCard from "../components/AnnouncementCard.astro";
import VideoCard from "../components/VideoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const now = new Date();
const announcements = (await getCollection("announcements"))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const pinned = announcements.find(
  (entry) =>
    entry.data.pinned &&
    (!entry.data.expiresAt || entry.data.expiresAt.getTime() >= now.getTime()),
);
const recent = announcements.slice(0, 3);
const featuredVideos = (await getCollection("videos"))
  .filter((entry) => !entry.data.draft && entry.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const nextPractice = site.practiceSchedule[0];
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Student-run badminton community</p>
        <h1>{site.hero.heading}</h1>
        <p class="hero-description">{site.hero.description}</p>
        <div class="button-group">
          <a class="button button-primary" href="/join/">Join a Practice</a>
          <a class="button button-secondary" href="/training-videos/">Watch Training Videos</a>
        </div>
      </div>
      {site.hero.imagePath ? (
        <img class="hero-image" src={site.hero.imagePath} alt="URI Badminton club practice" />
      ) : (
        <div class="court-art" aria-hidden="true">
          <span class="court-net"></span>
          <span class="shuttle"></span>
          <span class="art-label">URI<br />Badminton</span>
        </div>
      )}
    </div>
  </section>

  {pinned && (
    <section class="notice-section" aria-labelledby="important-heading">
      <div class="container">
        <div class="important-notice">
          <div>
            <p class="notice-label">Important announcement</p>
            <h2 id="important-heading">{pinned.data.title}</h2>
            <p>{pinned.data.summary}</p>
          </div>
          <a class="button button-light" href={`/announcements/${pinned.id}/`}>Read update</a>
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="next-practice-heading">
    <div class="container split-section">
      <div class="section-heading">
        <p class="eyebrow">Get on court</p>
        <h2 id="next-practice-heading">Next practice</h2>
        <p>Practice details are maintained in one place and will be updated as soon as organizers confirm them.</p>
      </div>
      <article class="practice-card">
        <p class="practice-label">{nextPractice.label}</p>
        <dl>
          <div><dt>Day</dt><dd>{nextPractice.day}</dd></div>
          <div><dt>Time</dt><dd>{nextPractice.time}</dd></div>
          <div><dt>Location</dt><dd>{nextPractice.location}</dd></div>
        </dl>
        <p class="practice-note">{nextPractice.note}</p>
        <a class="text-link" href="/schedule/">View full schedule <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="recent-heading">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Stay informed</p>
          <h2 id="recent-heading">Recent announcements</h2>
        </div>
        <a class="text-link desktop-only-link" href="/announcements/">View all announcements <span aria-hidden="true">→</span></a>
      </div>
      {recent.length > 0 ? (
        <div class="card-grid">
          {recent.map((entry) => (
            <AnnouncementCard id={entry.id} {...entry.data} />
          ))}
        </div>
      ) : (
        <div class="empty-state"><h3>No announcements yet</h3><p>Community updates will appear here.</p></div>
      )}
      <a class="text-link mobile-only-link" href="/announcements/">View all announcements <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="videos-heading">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Build your game</p>
          <h2 id="videos-heading">Featured training videos</h2>
        </div>
        <a class="text-link desktop-only-link" href="/training-videos/">Browse videos <span aria-hidden="true">→</span></a>
      </div>
      {featuredVideos.length > 0 ? (
        <div class="video-grid">
          {featuredVideos.map((entry) => <VideoCard {...entry.data} />)}
        </div>
      ) : (
        <div class="empty-state">
          <span class="empty-icon" aria-hidden="true">▶</span>
          <h3>Practice videos are coming soon</h3>
          <p>Training clips and session notes will appear here after organizers publish real videos.</p>
        </div>
      )}
    </div>
  </section>

  <section class="join-band">
    <div class="container join-band-inner">
      <div>
        <p class="eyebrow">Your next rally starts here</p>
        <h2>There’s a place for you on court.</h2>
        <p>Come meet the community, try a practice, and play at your pace.</p>
      </div>
      <a class="button button-gold" href="/join/">How to join</a>
    </div>
  </section>
</BaseLayout>
