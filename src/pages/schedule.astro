---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Schedule" description="Weekly practice schedule for the URI Badminton student community.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Plan your practice</p>
      <h1>Schedule</h1>
      <p>Recurring practice details will be posted here as soon as student organizers confirm them.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="schedule-list">
        {site.practiceSchedule.map((session) => (
          <article class="practice-card schedule-card">
            <p class="practice-label">{session.label}</p>
            <dl>
              <div><dt>Day</dt><dd>{session.day}</dd></div>
              <div><dt>Time</dt><dd>{session.time}</dd></div>
              <div><dt>Location</dt><dd>{session.location}</dd></div>
            </dl>
            <p class="practice-note">{session.note}</p>
          </article>
        ))}
      </div>
      <div class="schedule-action">
        <p>Interested in playing with us?</p>
        <a class="button button-primary" href="/join/">Join a practice</a>
      </div>
    </div>
  </section>
</BaseLayout>
