---
import { site } from "../data/site";

const year = new Date().getFullYear();
const links = [
  { href: "/", label: "Home" },
  { href: "/schedule/", label: "Schedule" },
  { href: "/training-videos/", label: "Training Videos" },
  { href: "/join/", label: "Join Us" },
];

const socialLinks = [
  site.contact.groupMeUrl && {
    href: site.contact.groupMeUrl,
    label: site.contact.groupMeLabel ?? "GroupMe",
    iconPath: "/icons/groupme.svg",
  },
  site.contact.instagramUrl && {
    href: site.contact.instagramUrl,
    label: "Instagram",
    iconPath: "/icons/instagram.svg",
  },
  site.contact.youtubeChannelUrl && {
    href: site.contact.youtubeChannelUrl,
    label: "YouTube",
    iconPath: "/icons/youtube.svg",
  },
].filter(Boolean) as { href: string; label: string; iconPath: string }[];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-title">{site.name}</p>
      <p class="footer-disclaimer">{site.disclaimer}</p>
    </div>
    <div>
      <p class="footer-heading">Explore</p>
      <ul class="footer-links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer-heading">Connect</p>
      {site.contact.email ? (
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      ) : socialLinks.length === 0 && (
        <p>Contact details to be announced.</p>
      )}
      {socialLinks.length > 0 && (
        <ul class="footer-links social-links">
          {socialLinks.map((link) => (
            <li>
              <a class="footer-social-link" href={link.href} rel="me noopener" target="_blank">
                <span class="footer-social-icon" aria-hidden="true">
                  <img src={link.iconPath} alt="" width="16" height="16" />
                </span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.name}. Student maintained.</p>
  </div>
</footer>
