---
import { beginnerFaqs } from "../data/faqs";
---

<div class="container faq-wrap">
  <div class="faq-heading">
    <p class="eyebrow">First practice, zero pressure</p>
    <h2>New to badminton?<br />You’re exactly who this is for.</h2>
    <p>Never held a racket? Coming alone? Slightly concerned that everyone else secretly trained for the Olympics? You’re fine. Here’s what your first practice is actually like.</p>
  </div>
  <div class="faq-list">
    {beginnerFaqs.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
          {item.sources && (
            <p class="faq-sources">
              Sources:
              {item.sources.map((source) => (
                <a href={source.href} target="_blank" rel="noopener">{source.label}</a>
              ))}
            </p>
          )}
        </div>
      </details>
    ))}
  </div>
</div>
